APP_NAME=Zylo Office Backend
# Environnement (T-002) : `development` est la seule valeur qui autorise les secrets
# de repli (JWT_SECRET, STORAGE_SIGNED_URL_SECRET, mot de passe changeme). Absente,
# elle vaut `production` : le backend refuse alors de démarrer avec ces valeurs.
# Voir docs/process/configuration.md.
ENVIRONMENT=development
PORT=3002
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]

# Local (dev) : PostgreSQL local. En production, cette variable pointe vers
# Neon (voir .env.production) — ne jamais coder l'URL en dur dans le code.
DATABASE_URL=postgresql+asyncpg://zylo_office:changeme@localhost:5432/zylo_office

# Secret de signature JWT — générer une vraie valeur aléatoire en local et en
# production (ex: openssl rand -hex 32). Ne jamais réutiliser cette valeur d'exemple.
JWT_SECRET=changeme-generate-a-real-random-secret

# Secret de signature des URL signées du stockage documentaire. Hors development,
# une valeur propre d'au moins 32 caractères est obligatoire (openssl rand -hex 32).
STORAGE_SIGNED_URL_SECRET=changeme-generate-a-real-random-secret

# Clé de chiffrement des champs sensibles : vide en local ; hors development et
# test, au moins 32 caractères (openssl rand -hex 32).
APP_FIELD_ENCRYPTION_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Limitation de débit de l'authentification (T-012) : login, register et refresh.
# Compteurs d'échecs dans PostgreSQL (table loginAttempt). Documentation complète
# et valeurs : docs/process/configuration.md §5 et docs/architecture/securite/authentification.md.
# Désactivation d'urgence (retour arrière sans revert) : AUTH_RATE_LIMIT_ENABLED=false.
AUTH_RATE_LIMIT_ENABLED=true
# Fenêtre glissante, en secondes, pendant laquelle les échecs sont comptés.
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Échecs tolérés pour un couple (IP, compte) avant verrou.
AUTH_RATE_LIMIT_MAX_FAILURES_PER_ACCOUNT=10
# Échecs tolérés pour une IP, tous comptes confondus, avant verrou de cette IP.
AUTH_RATE_LIMIT_MAX_FAILURES_PER_IP=100
# Durée du premier verrou, doublée à chaque échec supplémentaire, plafonnée à MAX.
AUTH_RATE_LIMIT_LOCK_BASE_SECONDS=60
AUTH_RATE_LIMIT_LOCK_MAX_SECONDS=900
# Adresses des reverse proxys de confiance : X-Forwarded-For n'est lu que depuis elles.
# Vide = aucun proxy (le client réel est l'adresse du pair direct). Ex. ["127.0.0.1"].
AUTH_RATE_LIMIT_TRUSTED_PROXIES=[]

# scripts/sync_holykell_live.py (démonstration end-to-end du module Zylo
# Liquid) — ce script n'est pas exécuté par l'app FastAPI, il faut le lancer
# à part. Les valeurs ci-dessous sont les défauts de dev local (simulateurs
# lancés en local sur les ports habituels) ; en production/VPS, remplacer
# HOLYKELL_SYNC_BASE_URL et STATION_SIM_DSN par les URLs réelles des
# simulateurs déployés.
HOLYKELL_SYNC_BASE_URL=http://localhost:8500
HOLYKELL_SYNC_USERNAME=jb.essomba
HOLYKELL_SYNC_PASSWORD=test1234
HOLYKELL_SYNC_ORG_ID=0879158e-0e28-45d7-8688-be2c81c96b37
STATION_SIM_DSN=postgresql://zylo:zylo@localhost:5432/station_sim
