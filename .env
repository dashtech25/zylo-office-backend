APP_NAME=Zylo Office Backend
ENVIRONMENT=development
PORT=3002
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]

# Local (dev) : PostgreSQL local. Une fois déployé, cette variable doit pointer
# vers la base de données en ligne — ne jamais coder l'URL en dur dans le code,
# uniquement via cette variable d'environnement.
DATABASE_URL=postgresql+asyncpg://zylo_office:changeme@localhost:5432/zylo_office

# Secret de signature JWT — générer une vraie valeur aléatoire en local et en
# production (ex: openssl rand -hex 32). Ne jamais réutiliser cette valeur d'exemple.
JWT_SECRET=changeme-generate-a-real-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30